+/// Whether position commands ask the Handy to stop at their target (HDSP `stop_on_target`).
+/// Off (the default) the Handy keeps moving at the commanded speed until the next command
+/// arrives, so a late command lets it travel past the position the app asked for. Read when a
+/// Handy connects.
+static STOP_ON_TARGET: AtomicBool = AtomicBool::new(false);
+
+/// Sets whether Handys connected from now on stop at each position command's target.
+pub fn set_stop_on_target(stop: bool) {
+  STOP_ON_TARGET.store(stop, Ordering::Relaxed);
+}
