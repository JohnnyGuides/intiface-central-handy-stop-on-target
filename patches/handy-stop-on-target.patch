+    let commands = handy
+      .handle_hw_position_with_duration_cmd(0, uuid!("00000000-0000-0000-0000-000000000001"), 25, 1_500)
+      .expect("position command should be created");
+    let HardwareCommand::Write(write) = &commands[0] else {
